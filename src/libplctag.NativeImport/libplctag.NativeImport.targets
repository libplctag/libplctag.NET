<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
		.NET Framework has no runtime selection of native NuGet assets, so ship every architecture's plctag.dll in its own
		subfolder; NativeMethods loads the one matching the process at runtime.
	-->
	<ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
		<Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\plctag.dll" Link="X86\plctag.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\plctag.dll" Link="X64\plctag.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-arm64\native\plctag.dll" Link="ARM64\plctag.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

</Project>
